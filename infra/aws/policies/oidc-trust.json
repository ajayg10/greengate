{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitLabCiOidc",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::__ACCOUNT_ID__:oidc-provider/gitlab.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": { "gitlab.com:aud": "https://gitlab.com" },
        "StringLike": { "gitlab.com:sub": __SUBS__ }
      }
    }
  ]
}
