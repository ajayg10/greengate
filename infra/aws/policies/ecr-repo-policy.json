{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaPullOurFunctions",
      "Effect": "Allow",
      "Principal": { "Service": "lambda.amazonaws.com" },
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Condition": { "StringLike": { "aws:sourceArn": "arn:aws:lambda:__REGION__:__ACCOUNT_ID__:function:*" } }
    }
  ]
}
